{
  "name": "haskellish-effect-ts",
  "private": true,
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "eslint \"packages/**/*.ts\"",
    "format": "prettier --write '**/*.{ts,js}'",
    "format:check": "prettier --check '**/*.{ts,js}'",
    "prepare": "husky",
    "// ↓ bun has no pack subcommand, so npm is used here instead": "",
    "show-package-files": "npm pack --dry-run --workspace packages/haskellish-effect --workspace packages/eslint-plugin-haskellish-effect --workspace packages/haskellish-effect-config",
    "// ↓ npm may warn about unsupported 'workspace:*' URLs, but this is harmless — the script doesn't rely on workspace resolution": "",
    "bump-versions": "cd packages/haskellish-effect && npm version patch ; cd ../eslint-plugin-haskellish-effect && npm version patch ; cd ../haskellish-effect-config && npm version patch ; echo 'Updated versions in packages'"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
