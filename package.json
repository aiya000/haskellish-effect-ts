{
  "name": "haskellish-effect-ts",
  "private": true,
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "bun run --filter 'packages/*' build",
    "test": "bun run --filter 'packages/*' test",
    "typecheck": "bun run --filter 'packages/*' typecheck && bun run --filter 'examples/*' typecheck",
    "lint": "bun run --filter 'examples/*' lint",
    "format": "prettier --write '**/*.{ts,js}'",
    "format:check": "prettier --check '**/*.{ts,js}'"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
